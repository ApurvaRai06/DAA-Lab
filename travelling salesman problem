#include <stdio.h>

#define INF 999999
//APURVA RAI
int n;
int cost[20][20];
int dp[1 << 20][20];

int min(int a, int b) {
    return (a < b) ? a : b;
}

int tsp(int mask, int pos) {
    // All cities have been visited
    if (mask == (1 << n) - 1) {
        if (cost[pos][0] == -1)
            return INF;
        return cost[pos][0];
    }

    // Already calculated
    if (dp[mask][pos] != -1)
        return dp[mask][pos];

    int ans = INF;

    for (int city = 0; city < n; city++) {
        // City not visited and connection exists
        if (!(mask & (1 << city)) && cost[pos][city] != -1) {
            int newCost = cost[pos][city] + tsp(mask | (1 << city), city);
            ans = min(ans, newCost);
        }
    }

    return dp[mask][pos] = ans;
}

int main() {
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    // Initialize DP table
    int totalMasks = 1 << n;

    for (int mask = 0; mask < totalMasks; mask++) {
        for (int i = 0; i < n; i++) {
            dp[mask][i] = -1;
        }
    }

    // Start from city 0
    int answer = tsp(1, 0);

    if (answer == INF)
        printf("-1\n");
    else
        printf("%d\n", answer);

    return 0;
}
