#include <stdio.h>
#include <limits.h>

#define MAX 1000
#define INF LLONG_MAX / 4

typedef struct {
    int u, v, w;
} Edge;

int main() {
    int V, E;
    scanf("%d", &V);
    scanf("%d", &E);

    Edge edges[MAX];

    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].w);
    }

    int source;
    scanf("%d", &source);

    long long dist[MAX];
    int parent[MAX];

    // Initialize distances
    for (int i = 1; i <= V; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }

    dist[source] = 0;

    // Bellman-Ford: Relax all edges V-1 times
    for (int i = 1; i <= V - 1; i++) {
        int changed = 0;

        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;

            if (dist[u] != INF && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                parent[v] = u;
                changed = 1;
            }
        }

        // Optimization: stop if no distance changed
        if (!changed)
            break;
    }

    // Check for a negative-weight cycle
    for (int i = 0; i < E; i++) {
        int u = edges[i].u;
        int v = edges[i].v;
        int w = edges[i].w;

        if (dist[u] != INF && dist[u] + w < dist[v]) {
            printf("Negative cycle detected\n");
            return 0;
        }
    }

    // Print result for every vertex except source
    for (int v = 1; v <= V; v++) {
        if (v == source)
            continue;

        if (dist[v] == INF) {
            printf("%d INF None\n", v);
        } else {
            int path[MAX];
            int count = 0;
            int current = v;

            // Construct path using parent array
            while (current != -1) {
                path[count++] = current;

                if (current == source)
                    break;

                current = parent[current];
            }

            printf("%d %lld ", v, dist[v]);

            // Print path in reverse order
            for (int i = count - 1; i >= 0; i--) {
                printf("%d", path[i]);

                if (i > 0)
                    printf("->");
            }

            printf("\n");
        }
    }

    return 0;
}
